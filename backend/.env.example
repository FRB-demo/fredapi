# EconSight Backend Configuration
# Copy this file to .env and update values as needed.

# FRED API key (get one free at https://fred.stlouisfed.org/docs/api/api_key.html)
# Leave empty to use demo/synthetic data.
FRED_API_KEY=

# Runtime environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (verbose errors, request logging)
DEBUG=true

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Upload limits
MAX_UPLOAD_SIZE_BYTES=10000000
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=50

# Cache settings
FRED_CACHE_TTL=900
FRED_CACHE_MAXSIZE=200
DEMO_CACHE_MAXSIZE=50

# Server port
BACKEND_PORT=8000

# Optional API key authentication (empty = no auth)
API_KEY=
